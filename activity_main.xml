<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="#CC000000"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartTrip"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etTripCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Enter Trip Code (e.g. TRIP123)"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:background="#22FFFFFF"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnJoinTrip"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Join Trip"
            android:backgroundTint="#8A2BE2"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnCreateShare"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Create &amp; Share to WhatsApp"
            android:backgroundTint="#2E8B57"/>

    </LinearLayout>

</RelativeLayout>
